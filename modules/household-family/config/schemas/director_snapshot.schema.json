{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
    },
    "policy_ref": {
      "type": "string"
    },
    "policy_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "authority_ref": {
      "type": "string",
      "minLength": 1
    },
    "permission": {
      "type": "string",
      "enum": [
        "OBSERVE",
        "PROPOSE",
        "EXECUTE_BOUNDED"
      ]
    },
    "allowed_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 400
      }
    },
    "allowed_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "canonical_j_source": {
      "type": "string",
      "minLength": 1
    },
    "ama_status": {
      "type": "string",
      "enum": [
        "AMBIGUOUS_SOURCE_AMA",
        "SOURCE_VERIFIED"
      ]
    },
    "cost_ceiling": {
      "type": "number",
      "minimum": 0
    },
    "max_repair_attempts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "auto_dispatch": {
      "type": "boolean"
    },
    "auto_dispatch_subject": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "revoked": {
      "type": "boolean"
    },
    "allowed_subjects": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
      }
    },
    "mandate_ref": {
      "type": "string",
      "minLength": 1
    },
    "hcc_review_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "ci_cost_approved": {
      "type": "boolean"
    },
    "accepted_versions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
      },
      "additionalProperties": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      }
    },
    "eligible_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
      }
    },
    "work_packages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "wp_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
          },
          "project_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
          },
          "repo": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$"
          },
          "version": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description_ref": {
            "type": "string"
          },
          "dependency_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
            }
          },
          "acceptance_criteria": {
            "minItems": 1,
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "method": {
                      "type": "string",
                      "const": "file_contains"
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 400
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "id",
                    "text",
                    "method",
                    "path",
                    "value"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "method": {
                      "type": "string",
                      "const": "json_equals"
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 400
                    },
                    "pointer": {
                      "type": "string"
                    },
                    "value": {
                      "$ref": "#/$defs/__schema0"
                    }
                  },
                  "required": [
                    "id",
                    "text",
                    "method",
                    "path",
                    "pointer",
                    "value"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "method": {
                      "type": "string",
                      "const": "ci_workflow"
                    },
                    "workflow_id": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "id",
                    "text",
                    "method",
                    "workflow_id"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "priority": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "eligibility_revision": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
          },
          "baseline_sha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "risk_tier": {
            "type": "string",
            "enum": [
              "LOW",
              "SENSITIVE",
              "UNKNOWN"
            ]
          },
          "scope_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "director_policy_ref": {
            "type": "string"
          },
          "max_repair_attempts": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "requested_action": {
            "type": "string",
            "enum": [
              "read",
              "branch_pr",
              "deploy",
              "delete",
              "release",
              "permissions"
            ]
          },
          "time_budget_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          },
          "mutation_recipe_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "repair_recipe_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "DISPATCHED",
              "NOT_DISPATCHED",
              "CLOSED"
            ]
          }
        },
        "required": [
          "wp_id",
          "project_id",
          "repo",
          "version",
          "title",
          "description_ref",
          "dependency_ids",
          "acceptance_criteria",
          "priority",
          "eligibility_revision",
          "baseline_sha",
          "risk_tier",
          "scope_hash",
          "director_policy_ref",
          "max_repair_attempts",
          "requested_action",
          "time_budget_seconds",
          "mutation_recipe_id",
          "repair_recipe_ids",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "recipes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "recipe_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
          },
          "class": {
            "type": "string",
            "const": "J1"
          },
          "auto_repair": {
            "type": "boolean"
          },
          "changes": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400
                },
                "previous_sha256": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "content": {
                  "type": "string",
                  "maxLength": 100000
                }
              },
              "required": [
                "path",
                "previous_sha256",
                "content"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "recipe_id",
          "class",
          "auto_repair",
          "changes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "project_id",
    "policy_ref",
    "policy_version",
    "revision",
    "issued_at",
    "expires_at",
    "authority_ref",
    "permission",
    "allowed_paths",
    "allowed_actions",
    "canonical_j_source",
    "ama_status",
    "cost_ceiling",
    "max_repair_attempts",
    "auto_dispatch",
    "auto_dispatch_subject",
    "revoked",
    "allowed_subjects",
    "mandate_ref",
    "hcc_review_ref",
    "ci_cost_approved",
    "accepted_versions",
    "eligible_ids",
    "work_packages",
    "recipes"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
