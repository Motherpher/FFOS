{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "wp_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
    },
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description_ref": {
      "type": "string"
    },
    "dependency_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
      }
    },
    "acceptance_criteria": {
      "minItems": 1,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "type": "string",
                "const": "file_contains"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "value": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "text",
              "method",
              "path",
              "value"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "type": "string",
                "const": "json_equals"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "pointer": {
                "type": "string"
              },
              "value": {
                "$ref": "#/$defs/__schema0"
              }
            },
            "required": [
              "id",
              "text",
              "method",
              "path",
              "pointer",
              "value"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "type": "string",
                "const": "ci_workflow"
              },
              "workflow_id": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "id",
              "text",
              "method",
              "workflow_id"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "priority": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "eligibility_revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
    },
    "baseline_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "risk_tier": {
      "type": "string",
      "enum": [
        "LOW",
        "SENSITIVE",
        "UNKNOWN"
      ]
    },
    "scope_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "director_policy_ref": {
      "type": "string"
    },
    "max_repair_attempts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "requested_action": {
      "type": "string",
      "enum": [
        "read",
        "branch_pr",
        "deploy",
        "delete",
        "release",
        "permissions"
      ]
    },
    "time_budget_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "mutation_recipe_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "repair_recipe_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "DISPATCHED",
        "NOT_DISPATCHED",
        "CLOSED"
      ]
    }
  },
  "required": [
    "wp_id",
    "project_id",
    "repo",
    "version",
    "title",
    "description_ref",
    "dependency_ids",
    "acceptance_criteria",
    "priority",
    "eligibility_revision",
    "baseline_sha",
    "risk_tier",
    "scope_hash",
    "director_policy_ref",
    "max_repair_attempts",
    "requested_action",
    "time_budget_seconds",
    "mutation_recipe_id",
    "repair_recipe_ids",
    "status"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
