{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
    },
    "wp_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
    },
    "wp_version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
    },
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$"
    },
    "policy_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
    },
    "policy_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "eligibility_revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
    },
    "eligibility_snapshot_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "baseline_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "commit_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "branch": {
      "type": "string"
    },
    "pr_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "DISCOVERED",
        "ELIGIBLE",
        "LEASED",
        "INSPECTING",
        "EXECUTING",
        "VERIFYING",
        "REPAIRING",
        "READY_FOR_DIRECTOR",
        "ACCEPTED",
        "RECORDED",
        "RECOVERY_CHECK",
        "HOLD_HUMAN",
        "BLOCKED",
        "FAILED",
        "CANCEL_REQUESTED",
        "STOPPED"
      ]
    },
    "revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "lease_owner": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "lease_expires_at": {
      "type": [
        "number",
        "null"
      ]
    },
    "current_attempt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "completed_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_error": {
      "type": [
        "string",
        "null"
      ]
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
    },
    "wp": {
      "type": "object",
      "properties": {
        "wp_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
        },
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$"
        },
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description_ref": {
          "type": "string"
        },
        "dependency_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
          }
        },
        "acceptance_criteria": {
          "minItems": 1,
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "method": {
                    "type": "string",
                    "const": "file_contains"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 400
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "id",
                  "text",
                  "method",
                  "path",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "method": {
                    "type": "string",
                    "const": "json_equals"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 400
                  },
                  "pointer": {
                    "type": "string"
                  },
                  "value": {
                    "$ref": "#/$defs/__schema0"
                  }
                },
                "required": [
                  "id",
                  "text",
                  "method",
                  "path",
                  "pointer",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "method": {
                    "type": "string",
                    "const": "ci_workflow"
                  },
                  "workflow_id": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "id",
                  "text",
                  "method",
                  "workflow_id"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "priority": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "eligibility_revision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
        },
        "baseline_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "risk_tier": {
          "type": "string",
          "enum": [
            "LOW",
            "SENSITIVE",
            "UNKNOWN"
          ]
        },
        "scope_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "director_policy_ref": {
          "type": "string"
        },
        "max_repair_attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "requested_action": {
          "type": "string",
          "enum": [
            "read",
            "branch_pr",
            "deploy",
            "delete",
            "release",
            "permissions"
          ]
        },
        "time_budget_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "mutation_recipe_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "repair_recipe_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "DISPATCHED",
            "NOT_DISPATCHED",
            "CLOSED"
          ]
        }
      },
      "required": [
        "wp_id",
        "project_id",
        "repo",
        "version",
        "title",
        "description_ref",
        "dependency_ids",
        "acceptance_criteria",
        "priority",
        "eligibility_revision",
        "baseline_sha",
        "risk_tier",
        "scope_hash",
        "director_policy_ref",
        "max_repair_attempts",
        "requested_action",
        "time_budget_seconds",
        "mutation_recipe_id",
        "repair_recipe_ids",
        "status"
      ],
      "additionalProperties": false
    },
    "evidence_bundle_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "stop_requested": {
      "type": "boolean"
    },
    "origin_subject": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
    },
    "recipe_bases": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{40}$"
      }
    },
    "recovery_state": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "DISCOVERED",
            "ELIGIBLE",
            "LEASED",
            "INSPECTING",
            "EXECUTING",
            "VERIFYING",
            "REPAIRING",
            "READY_FOR_DIRECTOR",
            "ACCEPTED",
            "RECORDED",
            "RECOVERY_CHECK",
            "HOLD_HUMAN",
            "BLOCKED",
            "FAILED",
            "CANCEL_REQUESTED",
            "STOPPED"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "run_id",
    "wp_id",
    "wp_version",
    "project_id",
    "repo",
    "policy_version",
    "policy_hash",
    "eligibility_revision",
    "eligibility_snapshot_hash",
    "baseline_sha",
    "commit_sha",
    "branch",
    "pr_ref",
    "state",
    "revision",
    "lease_owner",
    "lease_expires_at",
    "current_attempt",
    "created_at",
    "updated_at",
    "completed_at",
    "last_error",
    "correlation_id",
    "idempotency_key",
    "wp",
    "evidence_bundle_hash",
    "stop_requested",
    "origin_subject",
    "recipe_bases",
    "recovery_state"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
