# Values below are placeholders, not working credentials or deployed services.
NODE_ENV=production
PORT=3000
HF_BIND_HOST=0.0.0.0
HF_DATABASE_URL=postgresql://household:REPLACE_AT_DEPLOYMENT@postgres:5432/household
HF_MIGRATE_ON_START=false
HF_PUBLIC_URL=https://household.invalid
HF_OAUTH_ISSUER=https://identity.invalid
HF_OAUTH_JWKS_URL=https://identity.invalid/.well-known/jwks.json
HF_OAUTH_INTROSPECTION_URL=https://identity.invalid/oauth/introspect
# Optional confidential service authorization, supplied only by secret manager:
HF_OAUTH_INTROSPECTION_AUTH=
HF_PRINCIPALS_JSON=[{"subject":"REPLACE_DIRECTOR_SUBJECT","projects":["ff-spatial-observe"]}]
HF_DIRECTOR_URL=https://director.invalid/household
HF_DIRECTOR_ISSUER=urn:ffos:director
HF_DIRECTOR_AUDIENCE=urn:ffos:household
HF_DIRECTOR_PUBLIC_KEY_FILE=/run/secrets/director-public.pem
HF_DIRECTOR_SERVICE_TOKEN=
HF_GITHUB_APP_ID=REPLACE_WITH_REGISTERED_APP_ID
HF_GITHUB_PRIVATE_KEY_FILE=/run/secrets/github-app-private.pem
HF_GITHUB_WEBHOOK_SECRET=REPLACE_WITH_HIGH_ENTROPY_SECRET
HF_CDX_ANCHOR_FILE=/run/secrets/ffos-cdx-anchor.json
HF_CDX_EVALUATE_URL=https://cdx.invalid/evaluate
HF_CDX_ISSUER=urn:cdx:policy-service
HF_CDX_AUDIENCE=urn:ffos:household
HF_CDX_PUBLIC_KEY_FILE=/run/secrets/cdx-public.pem
HF_CDX_SERVICE_TOKEN=
HF_POSTGRES_PASSWORD=REPLACE_WITH_HIGH_ENTROPY_SECRET
