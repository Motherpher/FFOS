      "const": "ama.approval/v0.2-candidate"
    },
    "approvalId": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "requestRef": {
      "$ref": "common.schema.json#/$defs/ref"
    },
    "approvedByRef": {
      "$ref": "common.schema.json#/$defs/ref"
    },
    "outcome": {
      "enum": [
        "APPROVE",
        "REJECT"
      ]
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
