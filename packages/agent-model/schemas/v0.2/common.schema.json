{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ama.example/contracts/v0.2/common.schema.json",
  "title": "AMA Candidate Common Contract v0.2",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9._-]{2,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "token": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9._-]{1,95}$"
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "effect": {
      "enum": [
        "E0_OBSERVE",
        "E1_INTERNAL_STATE",
        "E2_REPOSITORY_CHANGE",
        "E3_EXTERNAL_EFFECT",
        "E4_AUTHORITY_CHANGE"
      ]
    },
    "life": {
      "enum": [
        "DRAFT",
        "REGISTERED",
        "VALIDATED",
        "DEPLOYABLE",
        "ACTIVE",
        "SUSPENDED",
        "DEPRECATED",
        "RETIRED"
      ]
    },
    "bindingStatus": {
      "enum": [
        "DRAFT",
        "VALIDATED",
        "ACTIVE",
        "SUSPENDED",
        "DEPRECATED"
      ]
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "version": {
          "$ref": "common.schema.json#/$defs/version"
        },
        "digest": {
          "$ref": "common.schema.json#/$defs/digest"
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "moduleId",
        "version",
        "enabled",
        "kind"
      ],
      "properties": {
        "moduleId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "version": {
          "$ref": "common.schema.json#/$defs/version"
        },
        "enabled": {
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "MEMORY",
            "RETRIEVAL",
            "SCHEDULING",
            "EVENTS",
            "REVIEW",
            "MULTI_AGENT",
            "CONNECTOR",
            "REASONING",
            "OTHER"
          ]
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "artifactRef",
        "digest"
      ],
      "properties": {
        "kind": {
          "enum": [
            "INPUT",
            "OUTPUT",
            "EVIDENCE"
          ]
        },
        "artifactRef": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "common.schema.json#/$defs/digest"
        }
      }
    }
  }
}
