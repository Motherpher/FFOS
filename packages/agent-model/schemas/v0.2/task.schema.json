{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "taskId",
    "version",
    "agentRef",
    "workflowRef",
    "commandRef",
    "state",
    "requestedScopes",
    "maxSteps",
    "runId"
  ],
  "properties": {
    "schema": {
      "const": "ama.task/v0.2-candidate"
    },
    "taskId": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "agentRef": {
      "$ref": "common.schema.json#/$defs/ref"
    },
    "workflowRef": {
      "$ref": "common.schema.json#/$defs/ref"
    },
    "commandRef": {
      "$ref": "common.schema.json#/$defs/ref"
    },
    "state": {
      "enum": [
        "QUEUED",
        "RUNNING",
        "HOLD",
        "PASS",
        "FAIL",
        "CANCELLED"
      ]
    },
    "requestedScopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/scope"
      }
    },
    "maxSteps": {
      "type": "integer",
      "minimum": 1
    },
    "runId": {
      "$ref": "common.schema.json#/$defs/id"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ama.example/contracts/v0.2/task.schema.json",
  "title": "AMA v0.2 candidate task contract"
}
