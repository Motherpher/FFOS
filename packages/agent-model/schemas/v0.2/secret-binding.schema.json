{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ama.example/contracts/v0.2/secret-binding.schema.json",
  "title": "AMA M2 provider-neutral runtime secret reference contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "bindingId",
    "version",
    "status",
    "agentRef",
    "capabilityRef",
    "providerRef",
    "secretRef",
    "resourceScope",
    "maxRotationAgeSeconds",
    "revocationCheckRequired",
    "accessAuditRequired",
    "runtimeInjectionRequired",
    "redactionRequired",
    "rawSecretMaterialAllowed"
  ],
  "properties": {
    "schema": {
      "const": "ama.secret-binding/v0.2-candidate"
    },
    "bindingId": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "status": {
      "$ref": "common.schema.json#/$defs/bindingStatus"
    },
    "agentRef": {
      "$ref": "common.schema.json#/$defs/ref"
    },
    "capabilityRef": {
      "$ref": "common.schema.json#/$defs/ref"
    },
    "providerRef": {
      "type": "string",
      "minLength": 1
    },
    "secretRef": {
      "type": "string",
      "pattern": "^ref:[A-Za-z0-9._/-]{3,240}$",
      "maxLength": 244
    },
    "resourceScope": {
      "$ref": "common.schema.json#/$defs/scope"
    },
    "maxRotationAgeSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "revocationCheckRequired": {
      "const": true
    },
    "accessAuditRequired": {
      "const": true
    },
    "runtimeInjectionRequired": {
      "const": true
    },
    "redactionRequired": {
      "const": true
    },
    "rawSecretMaterialAllowed": {
      "const": false
    }
  }
}
