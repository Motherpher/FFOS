{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "ama.authorization-request/v0.2-candidate"
    },
    "requestId": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "runId": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "agentRef": {
      "$ref": "common.schema.json#/$defs/ref"
    },
    "actorRef": {
      "$ref": "common.schema.json#/$defs/ref"
    },
    "workloadRef": {
      "$ref": "common.schema.json#/$defs/ref"
    },
    "mandateRef": {
      "$ref": "common.schema.json#/$defs/ref"
    },
    "capabilityRef": {
      "$ref": "common.schema.json#/$defs/ref"
    },
    "policyRef": {
      "$ref": "common.schema.json#/$defs/ref"
    },
    "effectRef": {
      "$ref": "common.schema.json#/$defs/ref"
    },
    "actionKind": {
      "enum": [
        "OBSERVE",
        "STATE_MUTATION",
        "REPOSITORY_MUTATION",
        "EXTERNAL_ACTION",
        "AUTHORITY_CHANGE"
      ]
    },
    "effectClass": {
      "$ref": "common.schema.json#/$defs/effect"
    },
    "resourceScope": {
      "$ref": "common.schema.json#/$defs/scope"
    },
