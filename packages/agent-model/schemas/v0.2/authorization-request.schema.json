      "enum": [
        "PUBLIC",
        "INTERNAL",
        "CONFIDENTIAL",
        "RESTRICTED"
      ]
    },
    "recipientId": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "requestedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sourceTrust": {
      "enum": [
        "TRUSTED_BOUNDARY",
        "UNTRUSTED_CONTENT"
      ]
    }
  },
  "required": [
    "schema",
    "requestId",
    "version",
    "runId",
    "agentRef",
    "actorRef",
    "workloadRef",
    "mandateRef",
    "capabilityRef",
    "policyRef",
    "actionKind",
    "effectClass",
    "resourceScope",
    "dataClassification",
    "recipientId",
    "purpose",
    "requestedAt",
    "sourceTrust"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ama.example/contracts/v0.2/authorization-request.schema.json",
  "title": "AMA 0.2 candidate provider-neutral authorization-request"
