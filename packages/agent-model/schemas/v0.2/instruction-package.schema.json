{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "ama.instruction-package/v0.2-candidate"
    },
    "packageId": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "status": {
      "$ref": "common.schema.json#/$defs/bindingStatus"
    },
    "moduleId": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "layerId": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "priority": {
            "type": "integer",
            "minimum": 0
          },
          "role": {
            "enum": [
              "SYSTEM",
              "DEVELOPER",
              "USER"
            ]
          },
          "sourceRef": {
            "type": "string",
            "minLength": 1
          },
          "contentDigest": {
            "$ref": "common.schema.json#/$defs/digest"
          },
          "sourceTrust": {
            "enum": [
              "DECLARED_UNVERIFIED",
              "VERIFIED_HOST_SOURCE"
            ]
          }
        },
        "required": [
          "layerId",
          "priority",
          "role",
          "sourceRef",
          "contentDigest",
          "sourceTrust"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schema",
    "packageId",
    "version",
    "status",
    "moduleId",
    "layers"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ama.example/contracts/v0.2/instruction-package.schema.json",
  "title": "AMA v0.2 candidate instruction-package contract"
}
