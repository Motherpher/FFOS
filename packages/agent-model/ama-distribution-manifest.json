    "namespace": "https://ama.example/contracts/v0.2/",
    "offline_resolvable": true
  },
  "interfaces": [
    "manifest",
    "workflow",
    "command",
    "capability",
    "tool-adapter",
    "task",
    "effect",
    "evidence",
    "authorization",
    "cognition",
    "memory",
    "durability",
    "evaluation",
    "operations"
  ],
  "required_assurance": [
    "schema_integrity",
    "reference_graph_closure",
    "effect_ceiling_nonamplification",
